{
  "name": "lumiverse-translator",
  "version": "0.5.8",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build src/backend.ts --outfile dist/backend.js --target bun && bun build src/frontend.ts --outfile dist/frontend.js --target browser",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "verify:original": "node scripts/verify-original.mjs",
    "pretest": "node scripts/verify-original.mjs",
    "test:original": "node scripts/test-original.mjs"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "lumiverse-spindle-types": "0.6.59",
    "typescript": "5.9.3"
  }
}
